# Copy to .env; .env is gitignored. detonate reads only the SEMGUARD_* variables.

# Reader: one OpenAI-compatible chat endpoint (vendor direct or a proxy), set per run.
SEMGUARD_LLM_URL=http://127.0.0.1:4000/v1
SEMGUARD_LLM_KEY=
SEMGUARD_LLM_MODEL=

# Provider keys for the two reader models of the #30 run; copy one into SEMGUARD_LLM_KEY per run.
#   gpt-5.4:          SEMGUARD_LLM_URL=https://api.openai.com/v1
#   gemini-3.8-flash: SEMGUARD_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: audit stage (--audit semselect|chat), milestone 1 only.
SEMGUARD_SEMSELECT_URL=http://127.0.0.1:8084
SEMGUARD_SEMSELECT_KEY=
SEMGUARD_SEMSELECT_REVISION=
SEMGUARD_SEMSELECT_MODEL_LOCK=
SEMGUARD_AUDIT_CHAT_MODEL=
