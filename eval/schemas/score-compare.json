{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "score-compare",
  "description": "Per-document 0-10 relevance scores, paragraph-grounded claims, and overall confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores", "claims", "confidence"],
  "properties": {
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "score"],
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "paragraph", "claim", "quote"],
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1
          },
          "paragraph": {
            "type": "integer",
            "minimum": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
